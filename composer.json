{
    "name": "wp-api-codeia/wp-api-codeia",
    "description": "Tests para WP API Codeia",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "yoast/phpunit-polyfills": "^1.0",
        "wp-phpunit/wp-phpunit": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit tests/unit",
        "test:integration": "phpunit tests/integration",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "autoload-dev": {
        "psr-4": {
            "WP_API_Codeia\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
